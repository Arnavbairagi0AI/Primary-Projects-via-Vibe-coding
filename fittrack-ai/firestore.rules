rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user matches the userId
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Match rules for the users collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Subcollections rules
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Match rules for visitorLeads
    match /visitorLeads/{leadId} {
      // Allow any visitor to submit their lead info
      allow create: if true;
      // Protect reading leads
      allow read, update, delete: if isAuthenticated();
    }
  }
}
