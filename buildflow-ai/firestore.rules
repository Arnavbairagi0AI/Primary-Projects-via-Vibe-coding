rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }
    
    // Helper function to check if user is Super Admin
    function isSuperAdmin() {
      return isAuth() && (
        request.auth.token.email == 'rinkibairagi1989@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin')
      );
    }

    // Helper function to check user's role
    function hasRole(role) {
      return isAuth() && (
        request.auth.token.email == 'rinkibairagi1989@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role
        ))
      );
    }
    
    // Helper function to check if user is in a company
    function belongsToCompany(companyId) {
      return isAuth() && (
        request.auth.token.email == 'rinkibairagi1989@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
        ))
      );
    }

    // --- USERS Collection ---
    match /users/{userId} {
      allow read: if isAuth() && (
        request.auth.uid == userId || 
        request.auth.token.email == 'rinkibairagi1989@gmail.com' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == resource.data.companyId)
      );
      // Allow creation during signup, or if Super Admin, or if Company Admin of same company
      allow create: if isAuth();
      allow update, delete: if isAuth() && (
        request.auth.uid == userId || 
        request.auth.token.email == 'rinkibairagi1989@gmail.com' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Company Admin' && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == resource.data.companyId)
      );
    }

    // --- COMPANIES Collection ---
    match /companies/{companyId} {
      allow read: if isAuth() && (belongsToCompany(companyId) || isSuperAdmin());
      // Anyone authenticated can create a company during onboarding
      allow create: if isAuth();
      allow update: if isAuth() && (
        isSuperAdmin() || 
        (belongsToCompany(companyId) && (hasRole('Company Admin') || hasRole('Super Admin')))
      );
      allow delete: if isSuperAdmin();
    }

    // --- EMPLOYEES Collection ---
    match /employees/{employeeId} {
      allow read: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(resource.data.companyId)
      );
      allow create: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(request.resource.data.companyId)
      );
      allow update, delete: if isAuth() && (
        isSuperAdmin() || 
        (belongsToCompany(resource.data.companyId) && (hasRole('Company Admin') || hasRole('Super Admin')))
      );
    }

    // --- TENDERS Collection ---
    match /tenders/{tenderId} {
      allow read: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(resource.data.companyId)
      );
      allow create: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(request.resource.data.companyId) && (
          hasRole('Company Admin') || 
          hasRole('Tender Manager') ||
          hasRole('Super Admin')
        )
      );
      allow update, delete: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(resource.data.companyId) && (
          hasRole('Company Admin') || 
          hasRole('Tender Manager') ||
          hasRole('Super Admin')
        )
      );
    }

    // --- PROJECTS Collection ---
    match /projects/{projectId} {
      allow read: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(resource.data.companyId)
      );
      allow write: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(request.resource.data.companyId) && (
          hasRole('Company Admin') || 
          hasRole('Project Manager') || 
          hasRole('Super Admin')
        )
      );
    }

    // --- NOTIFICATIONS Collection ---
    match /notifications/{notificationId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isAuth(); // Allow server/users to trigger notification
      allow update, delete: if isAuth() && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    // --- ACTIVITY LOGS Collection ---
    match /activityLogs/{logId} {
      allow read: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(resource.data.companyId)
      );
      allow create: if isAuth(); // Always allow logging activity
      allow update, delete: if isSuperAdmin();
    }

    // --- CALENDAR EVENTS Collection ---
    match /calendarEvents/{eventId} {
      allow read: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(resource.data.companyId)
      );
      allow create: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(request.resource.data.companyId)
      );
      allow update, delete: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(resource.data.companyId)
      );
    }

    // --- DOCUMENTS Collection ---
    match /documents/{docId} {
      allow read: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(resource.data.companyId)
      );
      allow create: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(request.resource.data.companyId)
      );
      allow update, delete: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(resource.data.companyId)
      );
    }

    // --- REPORTS Collection ---
    match /reports/{reportId} {
      allow read: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(resource.data.companyId)
      );
      allow create: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(request.resource.data.companyId)
      );
      allow update, delete: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(resource.data.companyId)
      );
    }

    // --- SETTINGS Collection ---
    match /settings/{settingsId} {
      allow read: if isAuth() && (settingsId == request.auth.uid || isSuperAdmin());
      allow write: if isAuth() && (settingsId == request.auth.uid || isSuperAdmin());
    }

    // --- AI CHATS Collection ---
    match /aiChats/{chatId} {
      allow read: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(resource.data.companyId)
      );
      allow create: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(request.resource.data.companyId)
      );
      allow update, delete: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(resource.data.companyId)
      );
    }

    // --- AI SUMMARIES Collection ---
    match /aiSummaries/{summaryId} {
      allow read: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(resource.data.companyId)
      );
      allow create: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(request.resource.data.companyId)
      );
      allow update, delete: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(resource.data.companyId)
      );
    }

    // --- AI ANALYSIS Collection ---
    match /aiAnalysis/{analysisId} {
      allow read: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(resource.data.companyId)
      );
      allow create: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(request.resource.data.companyId)
      );
      allow update, delete: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(resource.data.companyId)
      );
    }

    // --- KNOWLEDGE BASE Collection ---
    match /knowledgeBase/{kbId} {
      allow read: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(resource.data.companyId)
      );
      allow create: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(request.resource.data.companyId)
      );
      allow update, delete: if isAuth() && (
        isSuperAdmin() || 
        belongsToCompany(resource.data.companyId)
      );
    }
  }
}
