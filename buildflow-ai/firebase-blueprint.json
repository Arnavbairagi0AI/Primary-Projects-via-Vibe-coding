{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "User profile and role details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "status": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["Super Admin", "Company Admin", "Tender Manager", "Project Manager", "Finance Manager", "Employee"] },
        "companyId": { "type": "string" },
        "onboarded": { "type": "boolean" },
        "phoneNumber": { "type": "string" }
      },
      "required": ["id", "createdAt", "updatedAt", "email", "role", "onboarded"]
    },
    "company": {
      "title": "Company Details",
      "description": "Details about construction company from onboarding",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "status": { "type": "string" },
        "companyName": { "type": "string" },
        "gstNumber": { "type": "string" },
        "pan": { "type": "string" },
        "registrationNumber": { "type": "string" },
        "ownerName": { "type": "string" },
        "businessEmail": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "address": { "type": "string" },
        "state": { "type": "string" },
        "city": { "type": "string" },
        "pincode": { "type": "string" },
        "website": { "type": "string" },
        "yearsInBusiness": { "type": "integer" },
        "annualTurnover": { "type": "string" },
        "employeeCount": { "type": "integer" },
        "constructionCategories": { "type": "array" },
        "preferredTenderCategories": { "type": "array" },
        "preferredStates": { "type": "array" }
      },
      "required": ["id", "createdAt", "updatedAt", "companyName", "gstNumber", "pan"]
    },
    "employee": {
      "title": "Employee Profile",
      "description": "Information about an employee under a company",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "status": { "type": "string" },
        "companyId": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" }
      },
      "required": ["id", "companyId", "name", "email", "role"]
    },
    "tender": {
      "title": "Tender Document",
      "description": "Tender posting information scanned or uploaded",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "status": { "type": "string" },
        "title": { "type": "string" },
        "tenderNumber": { "type": "string" },
        "authority": { "type": "string" },
        "value": { "type": "number" },
        "valueUnit": { "type": "string" },
        "publishDate": { "type": "string" },
        "deadlineDate": { "type": "string" },
        "state": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "aiMatchScore": { "type": "number" },
        "aiMatchReasoning": { "type": "string" }
      },
      "required": ["id", "title", "tenderNumber", "authority", "value"]
    },
    "project": {
      "title": "Project Details",
      "description": "Project tracked by the company, converted from standard tenders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "status": { "type": "string" },
        "companyId": { "type": "string" },
        "title": { "type": "string" },
        "client": { "type": "string" },
        "value": { "type": "number" },
        "valueUnit": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "managerId": { "type": "string" },
        "progress": { "type": "number" }
      },
      "required": ["id", "companyId", "title", "client", "value"]
    },
    "notification": {
      "title": "System Notification",
      "description": "System or match notification sent to a specific user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "status": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "type": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "read"]
    },
    "activityLog": {
      "title": "Activity Log",
      "description": "Record of system activity for audit purposes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "status": { "type": "string" },
        "companyId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "role": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "action"]
    },
    "calendarEvent": {
      "title": "Calendar Event",
      "description": "Bidding milestone or custom event on calendar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "companyId": { "type": "string" },
        "date": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["pre_bid", "deadline", "meeting", "review"] },
        "tenderNumber": { "type": "string" },
        "time": { "type": "string" },
        "reminder": { "type": "boolean" }
      },
      "required": ["id", "companyId", "date", "title", "type"]
    },
    "document": {
      "title": "Document Metadata",
      "description": "Contract or bidding document details and AI summary",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "size": { "type": "string" },
        "category": { "type": "string" },
        "uploadDate": { "type": "string" },
        "aiStatus": { "type": "string", "enum": ["scanned", "pending"] },
        "url": { "type": "string" },
        "summary": { "type": "string" },
        "keyClaws": { "type": "array" }
      },
      "required": ["id", "companyId", "name", "category"]
    },
    "report": {
      "title": "Analytical Report",
      "description": "Historical pipeline or performance report metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "companyId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "parameters": { "type": "object" }
      },
      "required": ["id", "companyId", "title", "type"]
    },
    "aiChat": {
      "title": "AI Chat History",
      "description": "Session logs of conversations with the Gemini assistant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "userId": { "type": "string" },
        "messages": { "type": "array" },
        "timestamp": { "type": "string" }
      },
      "required": ["companyId", "userId", "messages", "timestamp"]
    },
    "aiSummary": {
      "title": "AI Tender Summary",
      "description": "AI-generated digests of contract specifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "userId": { "type": "string" },
        "tenderId": { "type": "string" },
        "tenderTitle": { "type": "string" },
        "tenderAuthority": { "type": "string" },
        "result": { "type": "object" },
        "timestamp": { "type": "string" }
      },
      "required": ["companyId", "userId", "tenderId", "result", "timestamp"]
    },
    "aiAnalysis": {
      "title": "AI Profile Analysis",
      "description": "Prequalification audit checks and risk analyses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "tenderId": { "type": "string" },
        "tenderTitle": { "type": "string" },
        "result": { "type": "object" },
        "timestamp": { "type": "string" }
      },
      "required": ["companyId", "userId", "type", "tenderId", "result", "timestamp"]
    },
    "knowledgeBase": {
      "title": "AI Knowledge Base Item",
      "description": "Custom contextual documents or files indexed for proposal grounding",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["companyId", "userId", "name", "content", "timestamp"]
    },
    "setting": {
      "title": "Portal Setting",
      "description": "Company portal visual and notification settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "companyId": { "type": "string" },
        "darkMode": { "type": "boolean" },
        "emailAlerts": { "type": "boolean" },
        "tenderMatches": { "type": "boolean" },
        "projectUpdates": { "type": "boolean" }
      },
      "required": ["id", "companyId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profile records"
    },
    "/companies/{companyId}": {
      "schema": "company",
      "description": "Onboarded companies information"
    },
    "/employees/{employeeId}": {
      "schema": "employee",
      "description": "Employee profiles under companies"
    },
    "/tenders/{tenderId}": {
      "schema": "tender",
      "description": "Database of Indian construction tenders"
    },
    "/projects/{projectId}": {
      "schema": "project",
      "description": "Current construction projects managed by companies"
    },
    "/notifications/{notificationId}": {
      "schema": "notification",
      "description": "Real-time user notifications"
    },
    "/activityLogs/{logId}": {
      "schema": "activityLog",
      "description": "Company and employee audit logs"
    },
    "/calendarEvents/{eventId}": {
      "schema": "calendarEvent",
      "description": "Milestone events and schedules"
    },
    "/documents/{docId}": {
      "schema": "document",
      "description": "Corporate documents and AI summary metadata"
    },
    "/reports/{reportId}": {
      "schema": "report",
      "description": "Analytical and pipeline reports"
    },
    "/aiChats/{chatId}": {
      "schema": "aiChat",
      "description": "AI Assistant conversational history"
    },
    "/aiSummaries/{summaryId}": {
      "schema": "aiSummary",
      "description": "AI-generated digests of contract specifications"
    },
    "/aiAnalysis/{analysisId}": {
      "schema": "aiAnalysis",
      "description": "Tender risk scorecards and qualification audits"
    },
    "/knowledgeBase/{kbId}": {
      "schema": "knowledgeBase",
      "description": "Indexed contextual guidelines for proposal grounding"
    },
    "/settings/{settingsId}": {
      "schema": "setting",
      "description": "Organization portal preferences"
    }
  }
}
