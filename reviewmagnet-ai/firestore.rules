rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users Collection rules
    match /users/{userId} {
      allow read, write: if true;
    }

    // Reviews Collection rules
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Payments Collection rules
    match /payments/{paymentId} {
      allow read, write: if true;
    }
  }
}

