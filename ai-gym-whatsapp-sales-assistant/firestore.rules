rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leads/{leadId} {
      allow read, write: if true;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
    
    match /bookings/{bookingId} {
      allow read, write: if true;
    }
    
    match /settings/{settingsId} {
      allow read, write: if true;
    }

    match /logs/{logId} {
      allow read, write: if true;
    }
  }
}
